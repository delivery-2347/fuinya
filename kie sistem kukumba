local function explodeAndDestroy(target: Frame, gui: ScreenGui, onComplete: () -> ())
    local originPos = target.AbsolutePosition
    local originSize = target.AbsoluteSize

    for _, child in ipairs(target:GetDescendants()) do
        if child:IsA("GuiObject") then
            local angle = math.rad(math.random(0, 360))
            local force = math.random(350, 700)
            local dur = math.random(6, 9) / 10

            TweenService:Create(
                child,
                TweenInfo.new(
                    dur,
                    Enum.EasingStyle.Quart,
                    Enum.EasingDirection.Out
                ),
                {
                    Position = child.Position + UDim2.new(
                        0,
                        math.cos(angle) * force,
                        0,
                        math.sin(angle) * force
                    ),
                    Rotation = math.random(-400, 400),
                    Size = UDim2.new(0, 0, 0, 0)
                }
            ):Play()

            if child:IsA("TextLabel") then
                TweenService:Create(
                    child,
                    TweenInfo.new(
                        dur * 0.7,
                        Enum.EasingStyle.Quad,
                        Enum.EasingDirection.Out
                    ),
                    {
                        TextTransparency = 1
                    }
                ):Play()

            elseif child:IsA("ImageLabel") or child:IsA("ImageButton") then
                TweenService:Create(
                    child,
                    TweenInfo.new(
                        dur * 0.7,
                        Enum.EasingStyle.Quad,
                        Enum.EasingDirection.Out
                    ),
                    {
                        ImageTransparency = 1
                    }
                ):Play()
            end
        end
    end

    local shardHolder = Instance.new("Folder")
    shardHolder.Parent = gui

    for _ = 1, 45 do
        local shard = Instance.new("Frame")

        local sW = math.random(6, 22)
        local sH = math.random(6, 22)

        local startX = originPos.X + math.random(0, originSize.X)
        local startY = originPos.Y + math.random(0, originSize.Y)

        shard.Size = UDim2.new(0, sW, 0, sH)
        shard.Position = UDim2.new(0, startX, 0, startY)

        shard.BackgroundColor3 =
            (math.random() > 0.4)
            and Color3.fromRGB(220, 220, 225)
            or Color3.fromRGB(15, 15, 18)

        shard.BorderSizePixel = 0
        shard.Parent = shardHolder

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1
        stroke.Color = Color3.fromRGB(200, 200, 200)
        stroke.Parent = shard

        local angle = math.rad(math.random(0, 360))
        local distance = math.random(300, 850)
        local dur = math.random(6, 10) / 10

        TweenService:Create(
            shard,
            TweenInfo.new(
                dur,
                Enum.EasingStyle.Quart,
                Enum.EasingDirection.Out
            ),
            {
                Position = UDim2.new(
                    0,
                    startX + math.cos(angle) * distance,
                    0,
                    startY + math.sin(angle) * distance
                ),
                Rotation = math.random(-720, 720),
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 0, 0, 0)
            }
        ):Play()
    end

    TweenService:Create(
        target,
        TweenInfo.new(
            0.6,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {
            BackgroundTransparency = 1,
            Size = target.Size + UDim2.new(0, 100, 0, 100),
            Position = target.Position - UDim2.new(0, 50, 0, 50)
        }
    ):Play()

    task.wait(0.75)

    gui:Destroy()
    onComplete()
end

task.spawn(function()
    local currentPercent = 0

    local function animateTo(
        targetPercent: number,
        duration: number,
        stageName: string
    )
        local startVal = currentPercent
        local startTime = os.clock()

        while true do
            local elapsed = os.clock() - startTime
            local alpha = math.clamp(elapsed / duration, 0, 1)
            local eased = 1 - (1 - alpha) * (1 - alpha)

            currentPercent = math.floor(
                startVal + (targetPercent - startVal) * eased
            )

            loadingText.Text = string.format(
                "%s (%d%%)",
                stageName,
                currentPercent
            )

            if alpha >= 1 then
                break
            end

            RunService.RenderStepped:Wait()
        end
    end

    animateTo(25, 2.0, "initialization")
    task.wait(0.3)

    animateTo(55, 2.5, "Collecting")
    task.wait(0.3)

    animateTo(80, 2.5, "load")
    task.wait(0.5)

    local player_role = access[localPlayer.UserId]

    if player_role then
        roleLabel.Text = player_role
        roleLabel.TextColor3 = Color3.fromRGB(80, 225, 125)

        animateTo(100, 1.8, "Welcome " .. player_role)
        task.wait(0.6)

        explodeAndDestroy(mainFrame, screenGui, function()
            executePayload(player_role)
        end)

    else
        roleLabel.Text = "No Access"
        roleLabel.TextColor3 = Color3.fromRGB(255, 60, 60)

        loadingText.Text = "You are not on the list"
        loadingText.TextColor3 = Color3.fromRGB(255, 60, 60)

        task.wait(2.5)

        localPlayer:Kick("You are not on the list")
    end
end)
