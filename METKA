local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local Mouse = Player:GetMouse()

local MARKER_SIZE = 10
local HOLD_TIME = 1
local FADE_TIME = 0.45

local function CreateMarker(position)
    local anchor = Instance.new("Part")
    anchor.Name = "MouseMarker"
    anchor.Size = Vector3.new(0.05, 0.05, 0.05)
    anchor.Position = position
    anchor.Anchored = true
    anchor.Transparency = 1
    anchor.CanCollide = false
    anchor.CanTouch = false
    anchor.CanQuery = false
    anchor.Parent = workspace

    local gui = Instance.new("BillboardGui")
    gui.Name = "MarkerGui"
    gui.Adornee = anchor
    gui.AlwaysOnTop = true
    gui.Size = UDim2.fromOffset(MARKER_SIZE, MARKER_SIZE)
    gui.Parent = anchor

    local scale = Instance.new("UIScale")
    scale.Scale = 0.7
    scale.Parent = gui

    local circle = Instance.new("Frame")
    circle.AnchorPoint = Vector2.new(0.5, 0.5)
    circle.Position = UDim2.fromScale(0.5, 0.5)
    circle.Size = UDim2.fromOffset(MARKER_SIZE, MARKER_SIZE)
    circle.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    circle.BorderSizePixel = 0
    circle.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = circle

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(50, 200, 100)
    stroke.Thickness = 2
    stroke.Parent = circle

    -- Появление
    TweenService:Create(
        scale,
        TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {
            Scale = 1
        }
    ):Play()

    -- Исчезновение
    task.delay(HOLD_TIME, function()
        local info = TweenInfo.new(
            FADE_TIME,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        )

        TweenService:Create(circle, info, {
            BackgroundTransparency = 1
        }):Play()

        TweenService:Create(stroke, info, {
            Transparency = 1
        }):Play()

        TweenService:Create(scale, info, {
            Scale = 0.8
        }):Play()

        task.wait(FADE_TIME)

        if anchor.Parent then
            anchor:Destroy()
        end
    end)
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.MouseButton3 then
        return
    end

    if not Mouse.Target then
        return
    end

    CreateMarker(Mouse.Hit.Position)
end)
